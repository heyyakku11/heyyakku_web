# Copy this file to .env and fill in real values.
# Only variables prefixed with VITE_ are exposed to the client.

VITE_APP_TITLE=HeyYakku
# Public HTTPS URL of the ASP.NET Core API (no trailing slash). Not localhost in production.
VITE_API_BASE_URL=http://localhost:3000
# Canonical website origin used in WhatsApp share links (falls back to window.location.origin).
VITE_PUBLIC_SITE_URL=

# --- Server-only (Vercel Project Settings > Environment Variables; NOT exposed to browser) ---
# Used by api/poll.ts for the /poll/:id Open Graph preview.
# Falls back to VITE_API_BASE_URL if unset.
POLL_API_BASE_URL=https://api.example.com
# Canonical HTTPS origin, no trailing slash, e.g. https://www.example.com
PUBLIC_SITE_URL=https://www.example.com
