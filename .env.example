# Local environment variables. Do not commit this file.
# Only variables prefixed with VITE_ are exposed to the client.

VITE_API_BASE_URL=
# Canonical website origin used in WhatsApp share links (falls back to window.location.origin).
VITE_WEBSITE_URL=

# Store pages the "Open in app" button falls back to when the app is not installed.
# Android defaults to the Play Store page for com.example.yakku; set the iOS App Store URL once published.
VITE_ANDROID_STORE_URL=
VITE_IOS_STORE_URL=

# Legal pages (/policy): company and contact details. Leave a value empty to hide that line.
VITE_LEGAL_ENTITY_NAME=
VITE_PRIVACY_CONTACT_EMAIL=
VITE_LEGAL_BUSINESS_ADDRESS=
