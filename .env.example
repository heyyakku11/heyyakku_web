# Local environment variables. Do not commit this file.
# Only variables prefixed with VITE_ are exposed to the client.

# Active environment: development | staging | production.
# Selects config/appsettings.{env}.json (production uses config/appsettings.json).
# If unset, the Vite mode decides: `vite dev` = development, `vite build` = production.
#   development -> com.yakku.app.dev
#   staging     -> com.yakku.app.staging
#   production  -> com.yakku.app
VITE_ENVIRONMENT=development

# SHA-256 signing fingerprints for /.well-known/assetlinks.json are NOT set here: they live in
# config/appsettings*.json under android.sha256Fingerprints.
# Apple Developer Team ID for the iOS association file's appID (TEAMID.bundleId).
# Disabled for now (see config/appConfigPlugin.ts); uncomment together with the plugin code.
# VITE_APPLE_TEAM_ID=

VITE_API_BASE_URL=
# Canonical website origin used in WhatsApp share links (falls back to window.location.origin).
VITE_WEBSITE_URL=

# Store pages the "Open in app" button falls back to when the app is not installed.
# Android defaults to the Play Store page for the active environment's package; set the iOS App Store URL once published.
VITE_ANDROID_STORE_URL=
VITE_IOS_STORE_URL=
